{
  "name": "dollarbaan",
  "version": "2.0.0",
  "description": "Self-hosted personal finance dashboard for tracking currency, gold, coin and crypto holdings in Toman, powered by Iran Market data",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahdiGraph/DollarBaan.git"
  },
  "author": "MahdiGraph",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0"
  },
  "overrides": {
    "node-gyp": "^11.5.0",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  }
}
