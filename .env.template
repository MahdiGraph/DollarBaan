# ===============================================
# DollarBaan configuration
# Copy this file to .env and adjust the values.
# Price source, refresh interval, display unit and the watchlist are
# managed from the Settings page; the PRICE_* values below are only
# the initial defaults.
# ===============================================

# -----------------------------------------------
# Login
# -----------------------------------------------
AUTH_USERNAME=admin               # Login username
AUTH_PASSWORD=changeit            # Initial password (change it here or from Settings > Security)
SESSION_MAX_AGE=604800000         # Session lifetime in milliseconds (604800000 = 7 days)

# -----------------------------------------------
# Server
# -----------------------------------------------
PORT=3000                         # HTTP port
# HOST=0.0.0.0                    # Listen address (default: all interfaces)
TRUST_PROXY=false                 # true when running behind a reverse proxy (nginx, Caddy, Cloudflare)
COOKIE_SECURE=auto                # auto = Secure cookie only over HTTPS; true or false to force

# -----------------------------------------------
# Database (SQLite by default, MySQL/MariaDB supported)
# -----------------------------------------------
DB_DIALECT=sqlite                 # sqlite or mysql
SQLITE_PATH=./database.sqlite     # SQLite file (relative to the project folder)
DB_NAME=dollarbaan                # MySQL database name
DB_USER=root                      # MySQL user
DB_PASSWORD=                      # MySQL password
DB_HOST=localhost                 # MySQL host
DB_PORT=3306                      # MySQL port

# -----------------------------------------------
# Market data (initial defaults, editable in Settings)
# -----------------------------------------------
PRICE_PROVIDER=iran-market        # iran-market (free, no key) or navasan
IRAN_MARKET_MIRROR=github         # github, jsdelivr or custom
# IRAN_MARKET_BASE_URL=           # Custom mirror of the Iran Market "data" folder
# NAVASAN_API_KEY=                # Only needed for the Navasan provider
REFRESH_INTERVAL_MINUTES=30       # How often prices are refreshed
HTTP_TIMEOUT=60000                # Timeout for market data requests (ms)

# -----------------------------------------------
# Logging
# -----------------------------------------------
LOG_LEVEL=info                    # debug, info, warn or error
LOG_DIR=./logs                    # Log folder, or "off" to log to the console only
