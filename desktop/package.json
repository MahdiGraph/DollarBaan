{
  "name": "dollarbaan-desktop",
  "productName": "DollarBaan",
  "version": "2.1.0",
  "description": "DollarBaan desktop app: personal finance dashboard for currency, gold, coin and crypto holdings in Toman",
  "homepage": "https://github.com/MahdiGraph/DollarBaan",
  "author": {
    "name": "MahdiGraph",
    "email": "34353346+MahdiGraph@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.mahdigraph.dollarbaan",
    "productName": "DollarBaan",
    "copyright": "Copyright © MahdiGraph",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public",
        "to": "web"
      }
    ],
    "electronLanguages": [
      "en-US",
      "fa"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "DollarBaan-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "artifactName": "DollarBaan-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "DollarBaan-${version}-windows-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Office",
      "executableName": "dollarbaan",
      "synopsis": "Personal finance dashboard for currency, gold, coin and crypto in Toman",
      "desktop": {
        "entry": {
          "Name": "DollarBaan",
          "Name[fa]": "دلاربان",
          "Categories": "Office;Finance;",
          "Keywords": "finance;portfolio;gold;currency;crypto;toman;"
        }
      }
    },
    "appImage": {
      "artifactName": "DollarBaan-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "packageName": "dollarbaan",
      "artifactName": "DollarBaan-${version}-linux-amd64.${ext}"
    }
  }
}
